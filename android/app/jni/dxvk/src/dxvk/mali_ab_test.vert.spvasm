OpCapability Shader
OpMemoryModel Logical GLSL450
OpEntryPoint Vertex %main "main" %gl_Position %outTexcoord
OpDecorate %gl_Position BuiltIn Position
OpDecorate %outTexcoord Location 0
%void = OpTypeVoid
%fn = OpTypeFunction %void
%float = OpTypeFloat 32
%v4float = OpTypeVector %float 4
%ptrOutputV4 = OpTypePointer Output %v4float
%gl_Position = OpVariable %ptrOutputV4 Output
%outTexcoord = OpVariable %ptrOutputV4 Output
%float0 = OpConstant %float 0
%float1 = OpConstant %float 1
%position = OpConstantComposite %v4float %float0 %float0 %float0 %float1
%texcoord = OpConstantComposite %v4float %float0 %float0 %float0 %float1
%main = OpFunction %void None %fn
%label = OpLabel
OpStore %gl_Position %position
OpStore %outTexcoord %texcoord
OpReturn
OpFunctionEnd
